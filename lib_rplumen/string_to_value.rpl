# The Lumen library file lib_lumen/string_to_value.lm, ported by scripts/port_examples.py; edit the Lumen original, not this file.

« 'c' =
    c is_digit if
        c ord "0" ord - return
    c ord 'code' =
    code "A" ord >= if
        code "Z" ord <=
    else
        false
    if
        code "A" ord - 10 + return
    code "a" ord >= if
        code "z" ord <=
    else
        false
    if
        code "a" ord - 10 + return
    1 neg return
» 'character_to_value' =

« 'base' = 'i' = 's' =
    i 'start' =
    0 'value' =
    1 'scale' =
    while i s len <
        s i char_at 'c' =
        c character_to_value 'd' =
        d 0 < if
            true
        else
            d base >=
        if
            break
        value base * d + 'value' =
        scale base * 'scale' =
        i 1 + 'i' =
    i start == if
        "expected digit" error
    [ value scale i ] return
» 'digits_to_base_value' =

« 'i' = 's' =
    i 'start' =
    0 'base_prefix' =
    while i s len <
        s i char_at 'c' =
        c is_digit not if
            break
        base_prefix 10 * c ord "0" ord - + 'base_prefix' =
        i 1 + 'i' =
    i start == if
        [ 0 start ] return
    10 'base' =
    base_prefix 'value' =
    i s len < if
        s i char_at "@" ==
    else
        false
    if
        base_prefix 'base' =
        base 2 < if
            true
        else
            base 36 >
        if
            "invalid base" error
        i 1 + 'i' =
        s i base digits_to_base_value 'r' =
        r 0 get 'value' =
        r 2 get 'i' =
    i s len < if
        s i char_at "." ==
    else
        false
    if
        i 1 + 'i' =
        s i base digits_to_base_value 'r2' =
        r2 0 get 'frac_val' =
        r2 1 get 'frac_scale' =
        r2 2 get 'i' =
        frac_scale 1 > if
            value frac_val frac_scale / + 'value' =
    [ value i ] return
» 'numeric_literal_to_value' =

« 's' =
    s len 0 == if
        0 return
    0 'i' =
    s i numeric_literal_to_value 'r' =
    r 0 get 'num_' =
    r 1 get 'i' =
    i s len < if
        s i char_at "/" ==
    else
        false
    if
        i 1 + 'i' =
        i s len == if
            s return
        s i numeric_literal_to_value 'r2' =
        r2 0 get 'denom' =
        r2 1 get 'i' =
        i s len != if
            s return
        num_ denom / return
    i s len == if
        num_ return
    s return
» 'string_to_value' =
