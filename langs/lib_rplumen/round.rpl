# The Lumen library file langs/lib_lumen/round.lm, ported by scripts/port_examples.py; edit the Lumen original, not this file.

« 'decimals' = 'x' =
    1 'scale' =
    0 'i' =
    while i decimals <
        scale 10 * 'scale' =
        i 1 + 'i' =
    x scale * 'y' =
    y 0 >= if
        y 2 * 1 + 2 // 'r' =
    else
        y 2 * 1 - 2 // 'r' =
    r scale // 'q' =
    q scale * r == if
        q return
    else
        r scale / return
    null return
» 'round' =
