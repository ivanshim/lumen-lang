« 'n' =
    n 1 + 'k' =
    while true
        k is_prime if
            k drop
        k 1 + 'k' =
    null return
» 'next_prime' =

« 'limit' =
    [ ] 'sieve' =
    0 'i' =
    while i limit <=
        true 'sieve' push
        i 1 + 'i' =
    0 false 'sieve' put
    1 false 'sieve' put
    2 'p' =
    while p p * limit <=
        sieve p get if
            p p * 'k' =
            while k limit <=
                k false 'sieve' put
                k p + 'k' =
        p 1 + 'p' =
    [ ] 'primes' =
    2 'i' =
    while i limit <=
        sieve i get if
            i 'primes' push
        i 1 + 'i' =
    primes return
» 'primes_up_to' =

« 'n' =
    n prime_factors 'f' =
    [ ] 'u' =
    0 'i' =
    while i f len <
        i 0 == if
            true
        else
            f i get f i 1 - get !=
        if
            f i get 'u' push
        i 1 + 'i' =
    u return
