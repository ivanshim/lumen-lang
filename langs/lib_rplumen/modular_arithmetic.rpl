« 'm' = 'exp' = 'base' =
    1 'result' =
    base m % 'base' =
    while exp 0 >
        exp 2 % 1 == if
            result base * m % 'result' =
        exp 2 // 'exp' =
        base base * m % 'base' =
    result return
» 'mod_pow' =
