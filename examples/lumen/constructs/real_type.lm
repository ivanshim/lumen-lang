# Test Real numeric type
# Basic real() conversions and operations

# Test 1: to_real(integer)
print("Test 1: to_real(integer)")
x = to_real(5)
print(x)

# Test 2: to_real(rational)
print("Test 2: to_real(rational)")
y = to_real(1/3)
print(y)

# Test 3: real(rational, precision)
print("Test 3: real(1/3, 50)")
z = real(1/3, 50)
print(z)

# Test 4: to_int(to_real)
print("Test 4: to_int(to_real(3.9)) should be 3")
result = to_int(to_real(10/3))
print(result)

# Test 5: Comparisons
print("Test 5: Comparisons")
a = to_real(2)
b = 2
if a == b
    print("to_real(2) == 2: true")
else
    print("to_real(2) == 2: false")

# Test 6: Type introspection (might not be available, but try)
print("Test 6: to_string(to_real)")
r = to_real(22/7)
print(r)
