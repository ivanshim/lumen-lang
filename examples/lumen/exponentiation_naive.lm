# Benchmark naive exponentiation with modular reduction
# Tests repeated exponentiation using simple multiplication loop
# The modulus is taken at every step, so that every value along the way
# stays inside a machine word and the program means the same thing in a
# language whose whole numbers have a width as in one whose do not.

base = 7
exp = 100
mod = 1000000007

iterations = 100

print("Naive exponentiation benchmark")
write("base = ")
print(base)
write("exp  = ")
print(exp)
write("mod  = ")
print(mod)
write("iterations = ")
print(iterations)
print("")

print("Running naive exponentiation...")

result = 0
i = 0
while i < iterations
    result = 1
    j = 0
    while j < exp
        result = result * base % mod
        j = j + 1
    i = i + 1

write("Result: ")
print(result)
print("Done!")
