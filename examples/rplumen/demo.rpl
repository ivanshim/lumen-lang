# RPLumen: reverse Polish Lumen. Every word acts on one stack.
# A literal pushes itself; an operator pops its operands and pushes the result.
5 3 + print          # 5 + 3

# A quoted name is data for the word after it, which must take a name: 8 'x' = assigns.
8 'x' =
x 2 * print

# Control words take their condition from the top of the stack.
x 10 < if
    "x is small" print
else
    "x is large" print
end

# Loops: while cond repeat body end, and do body until cond end.
0 'i' =
while i 3 < repeat
    i print
    i 1 + 'i' =
end

# The derived operators and the rest of the floor.
true false or print
false not print
10 neg 3 + print
2 10 ** print
7 2 / print
7 2 // print
7 2 % print
"reverse " "Polish" . print
1.5 2 * print
16@FF print

# Arrays gather what their body pushes.
[ 1 2 3 ] 'arr' =
arr print
4 'arr' push
arr 2 get print
0 99 'arr' put
arr print
arr len print

# Stack words, as on the HP-48.
1 2 swap print print
3 dup * print
1 2 3 rot print print print
