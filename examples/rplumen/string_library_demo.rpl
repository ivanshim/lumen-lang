"=== String Library Examples ===" print
"" print
"Hello World" 'text' =
"Original: " write
text print
"substring(text, 0, 5): " write
text 0 5 substring print
"substring(text, 6, 11): " write
text 6 11 substring print
"" print
"substring_end(text, 6): " write
text 6 substring_end print
"" print
"substring_start(text, 5): " write
text 5 substring_start print
"" print
"starts_with('Hello World', 'Hello'): " write
text "Hello" starts_with print
"starts_with('Hello World', 'World'): " write
text "World" starts_with print
"" print
"ends_with('Hello World', 'World'): " write
text "World" ends_with print
"ends_with('Hello World', 'Hello'): " write
text "Hello" ends_with print
"" print
"repeat_string('Ha', 5): " write
"Ha" 5 repeat_string print
"repeat_string('-=', 10): " write
"-=" 10 repeat_string print
"" print
[ "apple" "banana" "cherry" ] 'fruits' =
"join_strings(['apple', 'banana', 'cherry'], ', '): " write
fruits ", " join_strings print
"join_strings(['apple', 'banana', 'cherry'], ' | '): " write
fruits " | " join_strings print
"" print
