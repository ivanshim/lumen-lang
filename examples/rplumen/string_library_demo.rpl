# Ported from examples/lumen/string_library_demo.lm by scripts/port_examples.py; edit the Lumen original, not this file.
"=== String Library Examples ===" print
"" print
"Hello World" 'text' =
"Original: " write
text print
"substring(text, 0, 5): " write
text 0 5 substring print
"substring(text, 6, 11): " write
text 6 11 substring print
"" print
"substring_end(text, 6): " write
text 6 substring_end print
"" print
"substring_start(text, 5): " write
text 5 substring_start print
"" print
"starts_with('Hello World', 'Hello'): " write
text "Hello" starts_with print
"starts_with('Hello World', 'World'): " write
text "World" starts_with print
"" print
"ends_with('Hello World', 'World'): " write
text "World" ends_with print
"ends_with('Hello World', 'Hello'): " write
text "Hello" ends_with print
"" print
"repeat_string('Ha', 5): " write
"Ha" 5 repeat_string print
"repeat_string('-=', 10): " write
"-=" 10 repeat_string print
"" print
[ "apple" "banana" "cherry" ] 'fruits' =
"join_strings(['apple', 'banana', 'cherry'], ', '): " write
fruits ", " join_strings print
"join_strings(['apple', 'banana', 'cherry'], ' | '): " write
fruits " | " join_strings print
"" print
"The quick brown fox jumps over the lazy dog" 'sentence' =
"index_of('The quick brown fox...', 'fox'): " write
sentence "fox" index_of print
"index_of('The quick brown fox...', 'cat'): " write
sentence "cat" index_of print
"" print
"has_substring('The quick brown fox...', 'quick'): " write
sentence "quick" has_substring print
"has_substring('The quick brown fox...', 'slow'): " write
sentence "slow" has_substring print
"" print
"=== Practical Example ===" print
"Lumen" 'name' =
"1.0" 'version' =
"A minimal language" 'description' =
"-" 40 repeat_string 'separator' =
separator print
"Project: " name . 'info' =
