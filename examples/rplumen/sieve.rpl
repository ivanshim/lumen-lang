« 'to_end' = 'from_start' = 's' =
    from_start 'index' =
    "" 'out' =
    while index to_end < repeat
        out s index char_at . 'out' =
        index 1 + 'index' =
    end
    out return
» 'substring' =

« 'to_here' = 's' =
    s 0 to_here substring return
» 'substring_start' =

« 'limit' =
    [ ] 'sieve' =
    0 'i' =
    while i limit <= repeat
        true 'sieve' push
        i 1 + 'i' =
    end
    0 false 'sieve' put
    1 false 'sieve' put
    2 'p' =
    while p p * limit <= repeat
        sieve p get if
            p p * 'k' =
            while k limit <= repeat
                k false 'sieve' put
                k p + 'k' =
            end
        end
        p 1 + 'p' =
    end
    [ ] 'primes' =
    2 'i' =
    while i limit <= repeat
        sieve i get if
            i 'primes' push
        end
        i 1 + 'i' =
    end
    primes return
» 'primes_up_to' =

10000 primes_up_to 'result' =
result to_string 'result_string' =
result_string 100 substring_start print
