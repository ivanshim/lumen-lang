# Ported from examples/lumen/constructs/array_mutations.lm by scripts/port_examples.py; edit the Lumen original, not this file.
"=== Array Features Test ===" print
[ 10 20 30 ] 'arr' =
"Array: " write
arr print
"arr[0] = " write
arr 0 get print
[ 1 2 3 ] 'arr2' =
1 999 'arr2' put
"After arr2[1]=999: " write
arr2 print
[ ] 'arr3' =
100 'arr3' push
200 'arr3' push
"After push: " write
arr3 print
"Done!" print
