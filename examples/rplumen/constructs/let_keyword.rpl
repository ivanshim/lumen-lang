"Test: let and let mut Keywords" print
10 'x' =
"let x = 10" print
x print
5 'y' =
"let mut y = 5" print
y print
20 'y' =
"After y = 20:" print
y print
100 'x' =
"After let x = 100 (shadowing):" print
x print
x y + 'result' =
"let result = x + y" print
result print
