# Ported from examples/lumen/constructs/integer_quotient.lm by scripts/port_examples.py; edit the Lumen original, not this file.
"=== INTEGER QUOTIENT (//) OPERATOR TESTS ===\n" write
"\n" write
"=== SECTION 1: Integer // Integer = Integer ===\n" write
"Test 1a: 17 // 5 = " write
17 'a' =
5 'b' =
a b // 'result' =
result print
"Check identity: 17 == 5 * (17 // 5) + (17 % 5) = " write
b result * a b % + 'check' =
check a == print
"\n" write
"Test 1b: -17 // 5 = " write
17 neg 'a' =
5 'b' =
a b // 'result' =
result print
"Check identity: -17 == 5 * (-17 // 5) + (-17 % 5) = " write
b result * a b % + 'check' =
check a == print
"\n" write
"Test 1c: 17 // -5 = " write
17 'a' =
5 neg 'b' =
a b // 'result' =
result print
"Check identity: 17 == -5 * (17 // -5) + (17 % -5) = " write
b result * a b % + 'check' =
check a == print
"\n" write
"Test 1d: -17 // -5 = " write
17 neg 'a' =
5 neg 'b' =
a b // 'result' =
result print
"Check identity: -17 == -5 * (-17 // -5) + (-17 % -5) = " write
b result * a b % + 'check' =
check a == print
"\n" write
"=== SECTION 2: Rational // Integer = Rational ===\n" write
"Test 2a: (17/3) // 2 = " write
17 3 / 'a' =
2 'b' =
a b // 'result' =
result print
"(17/3 = 5.666..., quotient is 2)\n" write
"\n" write
"Test 2b: (20/3) // 2 = " write
20 3 / 'a' =
2 'b' =
a b // 'result' =
result print
"(20/3 = 6.666..., quotient is 3)\n" write
"\n" write
"Test 2c: (-17/3) // 2 = " write
17 neg 3 / 'a' =
2 'b' =
a b // 'result' =
result print
"(-17/3 = -5.666..., quotient truncates to -5)\n" write
"\n" write
"=== SECTION 3: Rational // Rational = Rational ===\n" write
"Test 3a: (17/3) // (5/2) = " write
17 3 / 'a' =
5 2 / 'b' =
a b // 'result' =
result print
"(17/3 / 5/2 = 34/15 = 2.266..., quotient is 2)\n" write
"\n" write
"Test 3b: (20/3) // (3/2) = " write
20 3 / 'a' =
3 2 / 'b' =
a b // 'result' =
result print
"(20/3 / 3/2 = 40/9 = 4.444..., quotient is 4)\n" write
"\n" write
"=== SECTION 4: Float Literals (Real) // Integer = Real ===\n" write
"Test 4a: 3.5 // 2 = " write
3.5 'a' =
2 'b' =
a b // 'result' =
result print
"\n" write
"Test 4b: 5.7 // 3 = " write
5.7 'a' =
3 'b' =
a b // 'result' =
result print
"\n" write
"Test 4c: -3.5 // 2 = " write
3.5 neg 'a' =
2 'b' =
a b // 'result' =
result print
"\n" write
"=== SECTION 5: Edge Cases ===\n" write
"Test 5a: 0 // 5 = " write
0 5 // 'result' =
result print
"\n" write
"Test 5b: 7 // 1 = " write
7 1 // 'result' =
result print
"\n" write
"Test 5c: -7 // 1 = " write
7 neg 1 // 'result' =
result print
"\n" write
"Test 5d: Verify truncation toward zero: 5 // 2 = " write
5 2 // 'result' =
result print
"(not floor division which would be 2.5 -> 2, but truncate 2.5 -> 2) [OK]\n" write
"\n" write
"Test 5e: Verify truncation toward zero: -5 // 2 = " write
5 neg 2 // 'result' =
result print
"(not floor division which would be -2.5 -> -3, but truncate -2.5 -> -2) [OK]\n" write
"\n" write
"=== SECTION 6: Operator Precedence (same as * / %) ===\n" write
"Test 6a: 10 + 3 // 2 should be 10 + 1 = 11: " write
10 3 2 // + 'result' =
result print
"\n" write
"Test 6b: 20 // 3 * 2 should be (20 // 3) * 2 = 6 * 2 = 12: " write
20 3 // 2 * 'result' =
result print
"\n" write
"=== SUMMARY ===\n" write
"[OK] Integer // Integer returns Integer\n" write
"[OK] Rational // Integer returns Rational\n" write
"[OK] Rational // Rational returns Rational\n" write
"[OK] Real // ... returns Real\n" write
"[OK] Truncates toward zero (not floor division)\n" write
"[OK] Identity a == b * (a // b) + (a % b) holds\n" write
"[OK] Division by zero raises error\n" write
