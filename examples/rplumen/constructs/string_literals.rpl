# Ported from examples/lumen/constructs/string_literals.lm by scripts/port_examples.py; edit the Lumen original, not this file.
"hello" 'single1' =
"world" 'single2' =
single1 print
single2 print
"hello" 'double1' =
"world" 'double2' =
double1 print
double2 print
single1 double1 == print
single2 double2 == print
"can't" 'escaped_single' =
escaped_single print
"text\\nmore" 'literal_n' =
literal_n print
"text\\tmore" 'literal_t' =
literal_t print
"can't" 'escaped_double' =
escaped_double print
"first\nsecond" 'newline_test' =
newline_test print
"col1\tcol2" 'tab_test' =
tab_test print
"He said \"hello\"" 'escaped_quote' =
escaped_quote print
"path\\to\\file" 'escaped_backslash' =
escaped_backslash print
"${name}" 'no_interp' =
no_interp print
"{count}" 'no_interp2' =
no_interp2 print
"10" 'x' =
"The answer is ${x}" 'no_interp3' =
no_interp3 print
