"Test: Short-Circuit Evaluation" print
"false and is_even(10):" print
false if 10 is_even else false end 'result' =
result print
"true and is_even(10):" print
true if 10 is_even else false end 'result' =
result print
"true or is_positive(5):" print
true if true else 5 is_positive end 'result' =
result print
"false or is_positive(5):" print
false if true else 5 is_positive end 'result' =
result print
"Testing division by zero avoidance:" print
0 'x' =
x 0 != if 10 x / 5 > else false end if
    "Result is greater than 5" print
else
    "x is zero or result is not greater than 5" print
end
