» 'is_digit' =

« 'c' =
    c ord 'o' =
    o "A" ord >= if o "Z" ord <= else false end if true else o "a" ord >= if o "z" ord <= else false end end return
» 'is_alpha' =

« 'c' =
    c is_alpha if true else c is_digit end return
» 'is_alnum' =

« 'c' =
    c ord 'o' =
    o "a" ord >= if o "z" ord <= else false end if
        o 32 - chr return
    else
        c return
    end
    null return
» 'char_to_upper' =

« 'c' =
    c ord 'o' =
    o "A" ord >= if o "Z" ord <= else false end if
        o 32 + chr return
    else
        c return
    end
    null return
