» 'has_lower_char' =

« 'pwd' =
    "  Password: '" pwd . "'" . print
    pwd len 8 < if
        "    WEAK: Too short (minimum 8 characters)" print
        false return
    end
    pwd has_digit_char not if
        "    WEAK: Must contain at least one digit" print
        false return
    end
    pwd has_alpha_char not if
        "    WEAK: Must contain at least one letter" print
        false return
    end
    pwd has_upper_char not if
        "    WEAK: Must contain at least one uppercase letter" print
        false return
    end
    pwd has_lower_char not if
        "    WEAK: Must contain at least one lowercase letter" print
        false return
    end
    "    STRONG: All requirements met" print
    true return
