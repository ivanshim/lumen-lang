"=== Practical Example: Username Validation ===" print
« 'c' =
    c is_alnum if
        true
    else
        c "_" ==
    if
        true
    else
        c "-" ==
    return
» 'is_valid_username_char' =

[ "a" "Z" "5" "_" "-" "!" "@" ] 'test_chars' =
0 'i' =
while i test_chars len <
    test_chars i get 'c' =
    c is_valid_username_char 'valid' =
    "  '" c . "' is valid username char: " . valid to_string . print
    i 1 + 'i' =
